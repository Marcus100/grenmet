{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/next"
  ],
  "files": {
    "includes": [
      "!.claude",
      "!apps/api/fastapi",
      // Legacy standalone XHTML players with large inline CSS/JS blocks that
      // predate and are not maintained by the modern Biome toolchain.
      "!geonetcast/Animation/HTML/my_animation.html",
      "!geonetcast/Animation/my_animation.html",
      "!**/.content-collections",
      // Vendored upstream copy of the Studio-Admin template (gitignored, kept
      // for reference only) — never lint/format it.
      "!next-shadcn-admin-dashboard-baseui",
      // Vendored GMS ops apps — keep upstream formatting so future upstream
      // diffs stay clean (see VENDORED.md).
      "!surface",
      "!wis2box",
      // Payload regenerates these on every CMS dev start in its own format;
      // linting them fails check:ci with no real change.
      "!apps/web/cms/src/payload-types.ts",
      "!apps/web/cms/src/app/(payload)/admin/importMap.js"
    ]
  },
  // Biome 2.6 formats YAML by default. Keep .yml/.yaml files unformatted as
  // before 2.6; adopting YAML formatting is a separate decision.
  "yaml": {
    "formatter": { "enabled": false }
  },
  "linter": {
    "rules": {
      // Rules marked "adopt separately" arrived with Ultracite 8.1 / Biome 2.6
      // and need per-site judgement (no safe fix); each is a follow-up.
      "style": {
        "noIncrementDecrement": "off",
        "useDestructuring": "off",
        "useErrorCause": "off",
        "useFilenamingConvention": "off",
        "useBlockStatements": "off",
        "useTemplate": "warn",
        "noNestedTernary": "warn",
        "noProcessEnv": "error",
        "useImportsFirst": "off", // adopt separately
        "useNamedCaptureGroup": "off", // adopt separately
        "useDomQuerySelector": "off" // adopt separately
      },
      "performance": {
        "noAwaitInLoops": "off",
        "noJsxPropsBind": "off",
        "noBarrelFile": "off"
      },
      "a11y": {
        "noSvgWithoutTitle": "warn",
        "noLabelWithoutControl": "off" // adopt separately
      },
      "correctness": {
        "noComponentHookFactories": "off" // adopt separately
      },
      "security": {
        "useIframeSandbox": "off" // adopt separately
      },
      "complexity": {
        "noRedundantDefaultExport": "off",
        "useArrayFind": "off",
        "noExcessiveCognitiveComplexity": {
          "level": "warn",
          "options": { "maxAllowedComplexity": 20 }
        }
      },
      "suspicious": {
        "noShadow": "off",
        "noUnnecessaryConditions": "off",
        "noLeakedRender": "off",
        "noEqualsToNull": "off",
        "noConsole": "warn",
        "useBaseline": "off", // adopt separately
        "noDuplicateSelectors": "off" // adopt separately
      }
    }
  },
  // Preserve existing source conventions; new style rules can be adopted separately.
  "assist": {
    "actions": {
      "source": {
        "useSortedKeys": "off",
        "useSortedPackageJson": "off",
        "useSortedTypeFields": "off",
        "useSortedSelectionSet": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/scripts/**", "*.mjs", "*.cjs"],
      "linter": {
        "rules": {
          "suspicious": { "noConsole": "off" },
          "style": { "noProcessEnv": "off" }
        }
      }
    },
    {
      "includes": ["packages/api-client/src/gen/**"],
      "linter": {
        "enabled": false
      }
    },
    {
      // Vendored shadcn/Base UI primitives. Relax only the rules that conflict
      // with upstream shadcn patterns so the code stays close to source for
      // re-syncs; real bug-catching rules (e.g. noDoubleEquals) stay on.
      // See biomejs.dev/linter and shadcn-ui/ui#7639.
      "includes": [
        "packages/ui/src/components/ui/**",
        "packages/ui/src/hooks/**"
      ],
      "linter": {
        "rules": {
          "a11y": {
            "useSemanticElements": "off",
            "noNoninteractiveElementInteractions": "off",
            "useFocusableInteractive": "off",
            "useKeyWithClickEvents": "off",
            "noStaticElementInteractions": "off",
            "useAriaPropsForRole": "off",
            "noLabelWithoutControl": "off"
          },
          "complexity": {
            "noExcessiveCognitiveComplexity": "off"
          },
          "correctness": {
            "noNestedComponentDefinitions": "off"
          },
          "performance": {
            "noNamespaceImport": "off"
          },
          "style": {
            "noNestedTernary": "off"
          },
          "security": {
            "noDangerouslySetInnerHtml": "off"
          },
          "suspicious": {
            "noArrayIndexKey": "off",
            "noDocumentCookie": "off"
          }
        }
      }
    },
    {
      // Components lifted from the Studio-Admin template (calendar +
      // date-range-picker). Additive; relax vendored-code patterns only, same
      // as the shadcn primitives above.
      "includes": [
        "apps/web/gaa-admin/src/components/calendar/**",
        "apps/web/gaa-admin/src/components/date-range-picker.tsx"
      ],
      "linter": {
        "rules": {
          "a11y": {
            "useSemanticElements": "off",
            "noNoninteractiveElementInteractions": "off",
            "useFocusableInteractive": "off",
            "useKeyWithClickEvents": "off",
            "noStaticElementInteractions": "off",
            "useAriaPropsForRole": "off",
            "noLabelWithoutControl": "off"
          },
          "complexity": {
            "noExcessiveCognitiveComplexity": "off",
            "noUselessFragments": "off",
            "noVoid": "off"
          },
          "correctness": {
            "noNestedComponentDefinitions": "off"
          },
          "performance": {
            "noNamespaceImport": "off"
          },
          "style": {
            "noNestedTernary": "off",
            "useConsistentTypeDefinitions": "off",
            "useAtIndex": "off",
            "noProcessEnv": "off"
          },
          "security": {
            "noDangerouslySetInnerHtml": "off"
          },
          "suspicious": {
            "noArrayIndexKey": "off",
            "noDocumentCookie": "off",
            "noConsole": "off"
          }
        }
      }
    },
    {
      // Admin form editors are config-driven (field-type switches + array
      // repeaters) that legitimately exceed the cognitive-complexity threshold.
      "includes": [
        "apps/web/gaa-admin/src/components/hr/**",
        "apps/web/gaa-admin/src/components/wxproducts/**"
      ],
      "linter": {
        "rules": {
          "complexity": { "noExcessiveCognitiveComplexity": "off" }
        }
      }
    },
    {
      "includes": [
        "**/env.ts",
        "**/env.*.ts",
        "**/instrumentation.ts",
        "**/instrumentation-client.ts",
        "**/sentry.server.config.ts",
        "**/sentry.edge.config.ts",
        "**/next.config.ts",
        "**/next.config.mjs",
        "**/playwright.config.ts"
      ],
      "linter": {
        "rules": {
          "style": { "noProcessEnv": "off" }
        }
      }
    },
    {
      // "content-collections" is a tsconfig path to generated code, not a
      // package; runtime-role loads pg from gaa-admin's manifest on purpose.
      // Keep this list to the files that do that so real undeclared imports
      // still fail.
      "includes": [
        "apps/web/docs/src/app/layout.tsx",
        "apps/web/docs/src/app/*/page.tsx",
        "apps/web/mbia/src/app/*/*/page.tsx",
        "apps/web/mbia/src/lib/content.ts",
        "apps/web/signal/src/lib/content.ts",
        "scripts/production/runtime-role.integration.test.mjs"
      ],
      "linter": {
        "rules": {
          "correctness": { "noUndeclaredDependencies": "off" }
        }
      }
    }
  ]
}
