# Lint and type-check run everywhere (Turbo caches them); tests run only for the
# packages whose files changed in the commits being pushed (no dependants), read
# from the refs git passes on stdin. CI runs the full suite.
# Set PRE_PUSH_SCOPE to any turbo flags to scope all three steps by hand, or to ""
# for a full local run of all three.
refs=""
[ -t 0 ] || refs=$(cat)

if [ -n "${PRE_PUSH_SCOPE+x}" ]; then
  pnpm check:ci $PRE_PUSH_SCOPE
  pnpm type-check $PRE_PUSH_SCOPE
  pnpm test $PRE_PUSH_SCOPE
  exit 0
fi

pnpm check:ci
pnpm type-check

scope=$(printf '%s\n' "$refs" | node scripts/verification/pre-push-scope.mjs)
case "$scope" in
  NONE)
    echo "pre-push: no package changed in the pushed commits; skipping tests."
    ;;
  ALL)
    pnpm test
    ;;
  *)
    echo "pre-push: testing changed packages only ($scope)"
    pnpm test $scope
    ;;
esac
