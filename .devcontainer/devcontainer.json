{
  "name": "grenmet-agents",
  "build": {
    "dockerfile": "Dockerfile"
  },

  // Language and repository tooling must run in the remote extension host so
  // it can see the container's runtimes, dependencies, and workspace paths.
  "customizations": {
    "vscode": {
      "extensions": [
        "biomejs.biome",
        "bradlc.vscode-tailwindcss",
        "charliermarsh.ruff",
        "eamodio.gitlens",
        "editorconfig.editorconfig",
        "formulahendry.auto-close-tag",
        "formulahendry.auto-rename-tag",
        "github.vscode-github-actions",
        "github.vscode-pull-request-github",
        "ms-python.mypy-type-checker",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter",
        "redhat.vscode-yaml",
        "tamasfe.even-better-toml",
        "unifiedjs.vscode-mdx",
        "vitest.explorer",
        "yoavbls.pretty-ts-errors"
      ]
    }
  },

  // Mount your repo into the container at /workspace. Files edited by the
  // agent inside the container are the same files on your host copy.
  // Create missing mountpoint directories as the host user before Docker mounts them.
  "initializeCommand": [
    "node",
    "${localWorkspaceFolder}/.devcontainer/prepare-host-mountpoints.mjs"
  ],
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",

  // Docker CLI + compose inside the container, talking to the HOST daemon
  // (docker-outside-of-docker). Lets the agent drive the vendored ops stacks
  // (surface/, wis2box/) and the pnpm-start infra. Containers still run on
  // the host — nothing is nested.
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },

  // Named volumes so Claude/Codex logins persist across rebuilds — log in once.
  // The second repo mount mirrors the HOST path: compose files use relative
  // bind mounts (e.g. surface/docker-compose.yml -> ./data), and the host
  // daemon needs paths that exist on the host. Run all `docker compose`
  // commands from ${localWorkspaceFolder}/<app>, never /workspace/<app>.
  "mounts": [
    // Container-only dependencies and caches, including the mirrored repo path.
    // Keep dependency-volumes.txt and the guardrail test in sync when adding apps.
    "source=grenmet-${devcontainerId}-node_modules,target=/workspace/node_modules,type=volume,volume-nocopy",
    "source=grenmet-${devcontainerId}-node_modules,target=${localWorkspaceFolder}/node_modules,type=volume,volume-nocopy",
    "source=grenmet-${devcontainerId}-apps-api-honoapi-node_modules,target=/workspace/apps/api/honoapi/node_modules,type=volume,volume-nocopy",
    "source=grenmet-${devcontainerId}-apps-api-honoapi-node_modules,target=${localWorkspaceFolder}/apps/api/honoapi/node_modules,type=volume,volume-nocopy",
    "source=grenmet-${devcontainerId}-apps-web-auth-node_modules,target=/workspace/apps/web/auth/node_modules,type=volume,volume-nocopy",
    "source=grenmet-${devcontainerId}-apps-web-auth-node_modules,target=${localWorkspaceFolder}/apps/web/auth/node_modules,type=volume,volume-nocopy",
    "source=grenmet-${devcontainerId}-apps-web-cms-node_modules,target=/workspace/apps/web/cms/node_modules,type=volume,volume-nocopy",
    "source=grenmet-${devcontainerId}-apps-web-cms-node_modules,target=${localWorkspaceFolder}/apps/web/cms/node_modules,type=volume,volume-nocopy",
    "source=grenmet-${devcontainerId}-apps-web-docs-node_modules,target=/workspace/apps/web/docs/node_modules,type=volume,volume-nocopy",
    "source=grenmet-${devcontainerId}-apps-web-docs-node_modules,target=${localWorkspaceFolder}/apps/web/docs/node_modules,type=volume,volume-nocopy",
    "source=grenmet-${devcontainerId}-apps-web-events-node_modules,target=/workspace/apps/web/events/node_modules,type=volume,volume-nocopy",
    "source=grenmet-${devcontainerId}-apps-web-events-node_modules,target=${localWorkspaceFolder}/apps/web/events/node_modules,type=volume,volume-nocopy",
    "source=grenmet-${devcontainerId}-apps-web-gaa-admin-node_modules,target=/workspace/apps/web/gaa-admin/node_modules,type=volume,volume-nocopy",
    "source=grenmet-${devcontainerId}-apps-web-gaa-admin-node_modules,target=${localWorkspaceFolder}/apps/web/gaa-admin/node_modules,type=volume,volume-nocopy",
    "source=grenmet-${devcontainerId}-apps-web-gms-node_modules,target=/workspace/apps/web/gms/node_modules,type=volume,volume-nocopy",
    "source=grenmet-${devcontainerId}-apps-web-gms-node_modules,target=${localWorkspaceFolder}/apps/web/gms/node_modules,type=volume,volume-nocopy",
    "source=grenmet-${devcontainerId}-apps-web-mbia-node_modules,target=/workspace/apps/web/mbia/node_modules,type=volume,volume-nocopy",
    "source=grenmet-${devcontainerId}-apps-web-mbia-node_modules,target=${localWorkspaceFolder}/apps/web/mbia/node_modules,type=volume,volume-nocopy",
    "source=grenmet-${devcontainerId}-apps-web-signal-node_modules,target=/workspace/apps/web/signal/node_modules,type=volume,volume-nocopy",
    "source=grenmet-${devcontainerId}-apps-web-signal-node_modules,target=${localWorkspaceFolder}/apps/web/signal/node_modules,type=volume,volume-nocopy",
    "source=grenmet-${devcontainerId}-packages-api-client-node_modules,target=/workspace/packages/api-client/node_modules,type=volume,volume-nocopy",
    "source=grenmet-${devcontainerId}-packages-api-client-node_modules,target=${localWorkspaceFolder}/packages/api-client/node_modules,type=volume,volume-nocopy",
    "source=grenmet-${devcontainerId}-packages-auth-node_modules,target=/workspace/packages/auth/node_modules,type=volume,volume-nocopy",
    "source=grenmet-${devcontainerId}-packages-auth-node_modules,target=${localWorkspaceFolder}/packages/auth/node_modules,type=volume,volume-nocopy",
    "source=grenmet-${devcontainerId}-packages-email-templates-node_modules,target=/workspace/packages/email-templates/node_modules,type=volume,volume-nocopy",
    "source=grenmet-${devcontainerId}-packages-email-templates-node_modules,target=${localWorkspaceFolder}/packages/email-templates/node_modules,type=volume,volume-nocopy",
    "source=grenmet-${devcontainerId}-packages-gms-node_modules,target=/workspace/packages/gms/node_modules,type=volume,volume-nocopy",
    "source=grenmet-${devcontainerId}-packages-gms-node_modules,target=${localWorkspaceFolder}/packages/gms/node_modules,type=volume,volume-nocopy",
    "source=grenmet-${devcontainerId}-packages-mdx-node_modules,target=/workspace/packages/mdx/node_modules,type=volume,volume-nocopy",
    "source=grenmet-${devcontainerId}-packages-mdx-node_modules,target=${localWorkspaceFolder}/packages/mdx/node_modules,type=volume,volume-nocopy",
    "source=grenmet-${devcontainerId}-packages-theme-node_modules,target=/workspace/packages/theme/node_modules,type=volume,volume-nocopy",
    "source=grenmet-${devcontainerId}-packages-theme-node_modules,target=${localWorkspaceFolder}/packages/theme/node_modules,type=volume,volume-nocopy",
    "source=grenmet-${devcontainerId}-packages-tsconfig-node_modules,target=/workspace/packages/tsconfig/node_modules,type=volume,volume-nocopy",
    "source=grenmet-${devcontainerId}-packages-tsconfig-node_modules,target=${localWorkspaceFolder}/packages/tsconfig/node_modules,type=volume,volume-nocopy",
    "source=grenmet-${devcontainerId}-packages-ui-node_modules,target=/workspace/packages/ui/node_modules,type=volume,volume-nocopy",
    "source=grenmet-${devcontainerId}-packages-ui-node_modules,target=${localWorkspaceFolder}/packages/ui/node_modules,type=volume,volume-nocopy",
    "source=grenmet-${devcontainerId}-turbo,target=/workspace/.turbo,type=volume,volume-nocopy",
    "source=grenmet-${devcontainerId}-turbo,target=${localWorkspaceFolder}/.turbo,type=volume,volume-nocopy",
    "source=grenmet-${devcontainerId}-apps-web-auth-next,target=/workspace/apps/web/auth/.next,type=volume,volume-nocopy",
    "source=grenmet-${devcontainerId}-apps-web-auth-next,target=${localWorkspaceFolder}/apps/web/auth/.next,type=volume,volume-nocopy",
    "source=grenmet-${devcontainerId}-apps-web-cms-next,target=/workspace/apps/web/cms/.next,type=volume,volume-nocopy",
    "source=grenmet-${devcontainerId}-apps-web-cms-next,target=${localWorkspaceFolder}/apps/web/cms/.next,type=volume,volume-nocopy",
    "source=grenmet-${devcontainerId}-apps-web-docs-next,target=/workspace/apps/web/docs/.next,type=volume,volume-nocopy",
    "source=grenmet-${devcontainerId}-apps-web-docs-next,target=${localWorkspaceFolder}/apps/web/docs/.next,type=volume,volume-nocopy",
    "source=grenmet-${devcontainerId}-apps-web-events-next,target=/workspace/apps/web/events/.next,type=volume,volume-nocopy",
    "source=grenmet-${devcontainerId}-apps-web-events-next,target=${localWorkspaceFolder}/apps/web/events/.next,type=volume,volume-nocopy",
    "source=grenmet-${devcontainerId}-apps-web-gaa-admin-next,target=/workspace/apps/web/gaa-admin/.next,type=volume,volume-nocopy",
    "source=grenmet-${devcontainerId}-apps-web-gaa-admin-next,target=${localWorkspaceFolder}/apps/web/gaa-admin/.next,type=volume,volume-nocopy",
    "source=grenmet-${devcontainerId}-apps-web-gms-next,target=/workspace/apps/web/gms/.next,type=volume,volume-nocopy",
    "source=grenmet-${devcontainerId}-apps-web-gms-next,target=${localWorkspaceFolder}/apps/web/gms/.next,type=volume,volume-nocopy",
    "source=grenmet-${devcontainerId}-apps-web-mbia-next,target=/workspace/apps/web/mbia/.next,type=volume,volume-nocopy",
    "source=grenmet-${devcontainerId}-apps-web-mbia-next,target=${localWorkspaceFolder}/apps/web/mbia/.next,type=volume,volume-nocopy",
    "source=grenmet-${devcontainerId}-apps-web-signal-next,target=/workspace/apps/web/signal/.next,type=volume,volume-nocopy",
    "source=grenmet-${devcontainerId}-apps-web-signal-next,target=${localWorkspaceFolder}/apps/web/signal/.next,type=volume,volume-nocopy",
    "source=grenmet-claude-config,target=/home/node/.claude,type=volume",
    "source=grenmet-codex-config,target=/home/node/.codex,type=volume",
    "source=grenmet-config,target=/home/node/.config,type=volume",
    "source=grenmet-cache,target=/home/node/.cache,type=volume",
    "source=${localWorkspaceFolder},target=${localWorkspaceFolder},type=bind,consistency=cached",
    // wis2box operational data (station lists, discovery metadata) — lives
    // outside the repo (WIS2BOX_HOST_DATADIR in wis2box/wis2box.env), mounted
    // at its mirror host path for the same reason as the repo mirror above.
    "source=${localEnv:HOME}/wis2box-data,target=${localEnv:HOME}/wis2box-data,type=bind,consistency=cached"
  ],

  // Lets in-container health checks reach host-published ports (SURFACE :8081,
  // wis2box :80, grenmet infra) as host.docker.internal on any Docker engine,
  // not just Docker Desktop.
  "runArgs": ["--add-host=host.docker.internal:host-gateway"],

  // No appPort: the app stack (Docker infra via `pnpm start` and the web dev
  // servers via `pnpm dev:web:*`) runs on the HOST, which owns ports 3000-3004,
  // 4000, 8000 directly. This container is only for the agent (editing, type-check,
  // tests), so publishing those ports here would collide with the host stack.

  "remoteUser": "node",

  // Claude's login/trust state lives in .claude.json. By default that file sits
  // in the home root (outside any volume) and is wiped on every rebuild, forcing
  // re-login. Pointing CLAUDE_CONFIG_DIR at the persisted .claude volume keeps
  // .claude.json next to .credentials.json inside that volume, so logins stick.
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/node/.claude",
    "GRENMET_HOST_WORKSPACE": "${localWorkspaceFolder}"
  },

  // On create: install workspace deps, then print every tool's version.
  "postCreateCommand": "sudo /usr/local/bin/prepare-agent-dependencies && node .devcontainer/check-dependency-isolation.mjs && pnpm install --frozen-lockfile && node -v && pnpm -v && uv --version && claude --version && codex --version",
  "postStartCommand": "node /workspace/.devcontainer/check-dependency-isolation.mjs"
}
