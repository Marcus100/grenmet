# GrenMet — production non-secret deploy config (committed; single source of truth).
# Layered under the runtime runtime/.env.local written by .github/workflows/deploy.yml:
#   docker compose --env-file production.env --env-file runtime/.env.local -f docker-compose.deploy.yml
# Secrets NEVER go in this file. TAG/WEB_TAG are dynamic (release tag) and are
# written into runtime/.env.local by the workflow.

ENVIRONMENT=production
BASE_DOMAIN=barrels.gd
DOMAIN=api.barrels.gd
ROUTER_SUFFIX=

# Postgres (server-level; passwords come from runtime/.env.local)
POSTGRES_DB=app_prod
POSTGRES_SERVER=db
POSTGRES_PORT=5432
WXWATCH_DB_NAME=wxwatch
WXWATCH_DB_USER=wxwatch
WXPRODUCTS_DB_NAME=wxproducts
WXPRODUCTS_DB_USER=wxproducts
EREGISTER_DB_NAME=eregister
EREGISTER_DB_USER=eregister
JANITORIAL_DB_NAME=janitorial
JANITORIAL_DB_USER=janitorial
TRANSPORT_DB_NAME=transport
TRANSPORT_DB_USER=transport
DB_HEALTH_START_PERIOD=30s

# Images
REGISTRY=ghcr.io
IMAGE_NAME=marcus100/grenmet
GHCR_OWNER=marcus100

# App config
PROJECT_NAME=Barrels Grenada
BACKEND_CORS_ORIGINS=https://barrels.gd,https://www.barrels.gd,https://auth.barrels.gd,https://admin.barrels.gd,https://gmsadmin.barrels.gd,https://gms.barrels.gd,https://docs.barrels.gd,https://weather.barrels.gd,https://signal.barrels.gd,https://mbia.barrels.gd,https://events.barrels.gd
EMAILS_FROM_EMAIL=noreply@barrels.gd
FRONTEND_HOST=https://auth.barrels.gd
REDIS_URL=redis://redis:6379/0

# Docker object names — MUST match what already exists on the production droplet
# (created by the old docker-compose.prod.yml under project grenmet).
PGDATA_VOLUME=grenmet_pgdata
REDIS_VOLUME=grenmet_redis-data
CERTS_VOLUME=grenmet_traefik-certificates

# CMS shares FastAPI identity; its data belongs to a dedicated role/database.
CMS_DB_USER=gms_cms
CMS_DB_NAME=gms_cms

# Least-privilege API/worker login; POSTGRES_USER remains the migration/admin role.
FASTAPI_DB_USER=app_runtime

# Events lives in the main database (events schema); it needs no extra settings.
# Mailing-list confirm/unsubscribe redirect origins (src/subscriptions).
SUBSCRIPTIONS_SITE_URLS='{"signal":"https://signal.barrels.gd","barrels":"https://barrels.gd","gms-alerts":"https://weather.barrels.gd"}'

# Admin host move (docs/deployment.md, "Admin host move"). Production is NOT cut
# over: the GMS/GAA portal keeps admin.barrels.gd (and its existing gmsadmin.barrels.gd),
# and the Barrels console waits on a holding host with sign-in off until its secret
# is set. Cutover release: BARRELS_ADMIN_HOST=admin.barrels.gd, GMSADMIN_HOST=gms.barrels.gd,
# and delete GMSADMIN_EXTRA_HOST.
BARRELS_ADMIN_HOST=console.barrels.gd
GMSADMIN_HOST=admin.barrels.gd
GMSADMIN_EXTRA_HOST=gmsadmin.barrels.gd
