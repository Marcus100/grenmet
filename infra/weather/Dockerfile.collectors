FROM python:3.13-slim-bookworm@sha256:9d7f287598e1a5a978c015ee176d8216435aaf335ed69ac3c38dd1bbb10e8d64 AS base
COPY --from=ghcr.io/astral-sh/uv:0.11.26@sha256:3d868e555f8f1dbc324afa005066cd11e1053fc4743b9808ca8025283e65efa5 /uv /bin/uv
ENV PYTHONUNBUFFERED=1 UV_LINK_MODE=copy PATH="/app/.venv/bin:$PATH"
WORKDIR /app
COPY pyproject.toml uv.lock ./
COPY apps/api/fastapi/pyproject.toml apps/api/fastapi/pyproject.toml
COPY scripts/scrapy-wxwatch/pyproject.toml scripts/scrapy-wxwatch/pyproject.toml
COPY scripts/gms-ingest/pyproject.toml scripts/gms-ingest/pyproject.toml
COPY scripts/sutron-collector/pyproject.toml scripts/sutron-collector/pyproject.toml
COPY notebooks/pyproject.toml notebooks/pyproject.toml
COPY geonetcast/pyproject.toml geonetcast/pyproject.toml
RUN useradd --create-home --uid 10001 collector

FROM base AS wxwatch
RUN uv sync --frozen --no-dev --package wxwatch
COPY scripts/scrapy-wxwatch scripts/scrapy-wxwatch
WORKDIR /app/scripts/scrapy-wxwatch
USER collector
ENTRYPOINT ["python", "run_crawlers.py"]
CMD ["all"]

FROM base AS gms-ingest
COPY scripts/gms-ingest scripts/gms-ingest
RUN uv sync --frozen --no-dev --package gms-ingest
USER collector
ENTRYPOINT ["nhc"]
CMD ["collect", "--output-dir", "/data/nhc"]

FROM base AS geonetcast
RUN apt-get update && apt-get install -y --no-install-recommends g++ libgdal-dev gdal-bin libhdf4-alt-dev && rm -rf /var/lib/apt/lists/*
COPY geonetcast geonetcast
RUN uv sync --frozen --no-dev --package geonetcast && python -c "from osgeo import gdal; assert gdal.VersionInfo().startswith('306')"
USER collector
WORKDIR /data/output
ENTRYPOINT ["python"]
# Operators select a verified processor and mount its required receiver inputs.
CMD ["-c", "raise SystemExit('GEONETCast integration unconfigured: select a processor and mount receiver inputs')"]
