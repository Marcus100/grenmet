# VCS
.git
.gitignore
.gitattributes

# Dev tooling
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Node
**/node_modules/
**/.pnpm-store/
**/.npm/
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Next.js / build outputs
**/.next/
**/out/
**/dist/
**/.turbo/
**/build/
**/*.tsbuildinfo

# Test / coverage
**/coverage/
**/test-results/
**/playwright-report/
**/.playwright/

# Python
**/__pycache__/
**/*.pyc
**/.venv/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/

# Env files
.env
.env.*
!.env.example

# Docs / CI (not needed in image)
*.md
.github/
docs/

# Unrelated services / data (not part of web builds)
notebooks/
geonetcast/
scripts/scrapy-wxwatch/
scripts/bishop-weather/raw/
artifacts/

# Vendored ops apps — run on the host, never part of web images.
# Also keeps their env-file secrets (production.env, wis2box.env) out of
# every build context.
surface/
wis2box/

# Security
secrets/
*.pem
*.key

# Logs
*.log
logs/

# Turbo cache
.turbo/

# Nested local secrets and authoritative runtime storage.
**/.env
**/.env.*
**/*.dump
**/*.sqlite*
**/backups/
**/acme.json
infra/docker/runtime/
data/
scripts/sutron-collector/data/

# Keep local caches, secrets and runtime artifacts out of every build.
**/.cache/
**/.scrapy/
**/.coverage
**/.coverage.*
**/.git/
**/*.env
**/*.log

# Local editor/agent state and scratch files are not application inputs.
.devcontainer/
.agents/
.claude/
.codex/
temp-files/
