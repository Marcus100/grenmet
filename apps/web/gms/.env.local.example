AUTH_API_URL=http://localhost:8000
AUTH_API_V1_STR=/api/v1
AUTH_ALLOWED_RETURN_HOSTS=localhost:3003

# Sentry error tracking (optional locally — get DSN from grenmet.sentry.io)
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development

# PostHog analytics (https://posthog.com → Project Settings → Project token)
NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_api_key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Public CAP warning endpoints (/api/cap/*). Unauthenticated, so this is
# independent of AUTH_API_URL above.
CAP_API_URL=http://localhost:8000

# Sign-in with the Barrels account (ADR-0017). Empty secret hides "Sign in".
AUTH_APP_URL=http://localhost:3000
WEATHER_SESSION_COOKIE_NAME=weather_session
WEATHER_SSO_CLIENT_SECRET=

# Shared with the API's TRUSTED_WEB_SECRET so sign-up rate limits key on the
# visitor's own address. Empty: every visitor shares one bucket. Min 32 characters.
TRUSTED_WEB_SECRET=
# Reverse proxies in front of this server that append to x-forwarded-for (1-5).
VISITOR_IP_PROXY_HOPS=1

# Optional CMS API base URL.
CMS_API_URL=

# Canonical public address, used for absolute share-preview links.
NEXT_PUBLIC_SITE_URL=http://localhost:3003

# Google Analytics measurement ID (G-...). Empty: no tracking.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Cloudflare Turnstile site key. Empty: no widget.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
