AUTH_API_URL=http://localhost:8000
AUTH_API_V1_STR=/api/v1
AUTH_ALLOWED_RETURN_HOSTS=localhost:3002
AUTH_APP_URL=http://localhost:3000

# Sign-in with the Barrels account (ADR-0017). Empty secret hides "Sign in".
DOCS_SESSION_COOKIE_NAME=docs_session
DOCS_SSO_CLIENT_SECRET=

# Canonical public address, used for absolute share-preview links.
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# Cloudflare Turnstile site key. Empty: no widget.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Sentry error tracking (optional locally — get DSN from grenmet.sentry.io)
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development

# PostHog analytics (https://posthog.com → Project Settings → Project token)
NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_api_key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
