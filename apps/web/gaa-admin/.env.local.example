RESEND_API_KEY=dev-placeholder
NEXT_PUBLIC_API_URL=http://localhost:8000

# Shared auth app (sign-in UI)
AUTH_APP_URL=http://localhost:3000

# FastAPI backend (server-side session exchange)
AUTH_API_URL=http://localhost:8000
AUTH_API_V1_STR=/api/v1

# Host-only session cookie (ADR-0017); must match the API's
# BROWSER_SESSION_COOKIE_NAME. Defaults to admin_session.
# ADMIN_SESSION_COOKIE_NAME=admin_session
# Single sign-on through the auth app: same value as the API's
# GAA_ADMIN_SSO_CLIENT_SECRET (32+ characters).
# GAA_ADMIN_SSO_CLIENT_SECRET=

# Optional server-side API override (defaults to AUTH_API_URL).
# Must be a valid URL if set. Leave the line COMMENTED OUT when unused —
# an empty value fails validation, while an absent one is accepted.
# CAP_API_URL=http://localhost:8000

# Optional domain databases. Leave these lines COMMENTED OUT until the module
# is configured — an empty value fails validation, an absent one is accepted.
# Passwords must match the matching *_DB_PASSWORD in infra/docker/.env.local.
# WXWATCH_DATABASE_URL=postgresql://wxwatch:changethis@localhost:5432/wxwatch
# WXPRODUCTS_DATABASE_URL=postgresql://wxproducts:changethis@localhost:5432/wxproducts

# Run admin-gms on port 3001 (auth app uses 3000)
PORT=3001

# Sentry error tracking (optional locally — get DSN from grenmet.sentry.io)
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development

# PostHog analytics (https://posthog.com → Project Settings → Project token)
NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_api_key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
