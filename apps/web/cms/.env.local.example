DATABASE_URL=postgresql://gms_cms:YOUR_URL_ENCODED_PASSWORD@localhost:5432/gms_cms
PAYLOAD_SECRET=YOUR_EXISTING_STABLE_PAYLOAD_SECRET

# Sign-in with the Barrels account (ADR-0017)
AUTH_API_URL=http://localhost:8000
AUTH_APP_URL=http://localhost:3000
CMS_URL=http://localhost:3006
CMS_DEPARTMENT_ID=GMS
CMS_SESSION_COOKIE_NAME=cms_session
# Empty hides "Sign in". Must be 32+ characters when set.
CMS_SSO_CLIENT_SECRET=

# Email. Empty RESEND_API_KEY: no mail is sent.
RESEND_API_KEY=
EMAILS_FROM_EMAIL=
EMAILS_FROM_NAME=GMS Content

# Weather site links. Empty: preview button and post links are off.
GMS_PREVIEW_URL=
GMS_SITE_URL=

# Shared with FastAPI's content-distribution endpoint. Empty: no social posting.
CMS_DISTRIBUTION_SECRET=
