# Barrels account (apps/web/account, port 3018). Every setting has a default, so this file is only
# needed to turn sign-in on locally.

# FastAPI backend and the Barrels sign-in app
AUTH_API_URL=http://localhost:8000
AUTH_API_V1_STR=/api/v1
AUTH_APP_URL=http://localhost:3000

# Bookings app address, to link each business on the My bookings page
# BOOKINGS_APP_URL=http://localhost:3015

# Host-only session cookie (default account_session)
# ACCOUNT_SESSION_COOKIE_NAME=account_session

# Single sign-on through the auth app: the same value as the API's ACCOUNT_SSO_CLIENT_SECRET
# (32+ characters, different from every other app's). Empty: sign-in is off and
# /auth/callback answers 503.
ACCOUNT_SSO_CLIENT_SECRET=

# Error reporting (optional)
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
