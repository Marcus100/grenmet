# Public auth app URL (used for OAuth callback redirects)
AUTH_APP_URL=http://localhost:3000

# FastAPI backend
AUTH_API_URL=http://localhost:8000
AUTH_API_V1_STR=/api/v1

# Host-only account session cookie (ADR-0017). Defaults to auth_session.
# AUTH_SESSION_COOKIE_NAME=auth_session

# Optional shared secret for FastAPI's server-to-server email renderer calls.
EMAIL_RENDER_SECRET=

# Allow redirects back to local apps (comma-separated). The origins of AUTH_APP_URL
# and the *_APP_URL settings below are always accepted; local ports from
# docs/ports.md work outside production. Add anything else here.
# 3001=gaa-admin, 3002=docs, 3003=gms, 3004=signal, 3005=mbia
AUTH_ALLOWED_RETURN_HOSTS=localhost:3001,localhost:3002,localhost:3003,localhost:3004

# Shared with the API's TRUSTED_WEB_SECRET (32+ characters) so mail-send rate
# limits key on the visitor, not this server. Empty: one shared bucket.
TRUSTED_WEB_SECRET=
# Reverse proxies in front of this server that append to x-forwarded-for (1-5).
AUTH_VISITOR_PROXY_HOPS=1

# App links on the account pages (optional; development falls back to the local
# ports in docs/ports.md, an unset URL in production leaves the app unlinked).
# ADMIN_APP_URL=http://localhost:3001
# BARRELS_ADMIN_APP_URL=http://localhost:3012
# MBIA_APP_URL=http://localhost:3005
# GMS_APP_URL=http://localhost:3003
# DOCS_APP_URL=http://localhost:3002
# SIGNAL_APP_URL=http://localhost:3004
# EVENTS_APP_URL=http://localhost:3009

# Sentry error tracking (optional locally — get DSN from grenmet.sentry.io)
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development

# PostHog analytics (https://posthog.com → Project Settings → Project token)
NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_api_key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Cloudflare Turnstile site key for the emailed-code start step. Empty: no widget
# (fine while the API has no AUTH_TURNSTILE_SECRET_KEY).
NEXT_PUBLIC_AUTH_TURNSTILE_SITE_KEY=
