# Public site URL — defaults to http://localhost:3004 when unset (see src/lib/env.ts)
NEXT_PUBLIC_SITE_URL=http://localhost:3004

# Sign-in with the Barrels account (ADR-0017). Empty secret hides "Sign in".
AUTH_API_URL=http://localhost:8000
AUTH_API_V1_STR=/api/v1
AUTH_APP_URL=http://localhost:3000
SIGNAL_SESSION_COOKIE_NAME=signal_session
SIGNAL_SSO_CLIENT_SECRET=

# Cloudflare Turnstile site key. Empty: no widget.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Sentry error tracking (optional locally — get DSN from grenmet.sentry.io)
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
