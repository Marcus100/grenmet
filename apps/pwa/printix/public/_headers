# Response headers for static hosting (copied to out/ by next build).
# The camera is allowed for this site only; the barcode reader needs
# WebAssembly. The CSP is enforced: connect-src names the production API
# origin (docs/deployment.md, https://api.barrels.gd) and nothing else.
# Changing the API origin means changing this line and VITE_API_URL together.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(self), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self'; connect-src 'self' https://api.barrels.gd; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'
