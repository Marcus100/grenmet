{
  "name": "@barrelsgd/pwa-printix",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pwa-kit-copy-zxing && vite --port 3064",
    "build": "pwa-kit-copy-zxing && vite build",
    "preview": "vite preview --port 3064",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "check:ci": "biome ci .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@barrelsgd/api-client": "workspace:*",
    "@barrelsgd/pwa-kit": "workspace:*",
    "@barrelsgd/ui": "workspace:*",
    "dexie": "catalog:",
    "qrcode": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "workbox-window": "catalog:"
  },
  "devDependencies": {
    "@barrelsgd/tsconfig": "workspace:*",
    "@tailwindcss/postcss": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/qrcode": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "fake-indexeddb": "catalog:",
    "jsdom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-pwa": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "24.x"
  }
}
