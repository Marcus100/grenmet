# Printix scanner (Vite). VITE_-prefixed values are written into the browser
# bundle at build time, so never put a secret here.
#
# Origin of the FastAPI service the scanner calls with its pairing secret. Plain
# http is accepted only for localhost; anything else must be https. Empty: the
# scanner shows "not connected" and checks no tickets.
# Production build: VITE_API_URL=https://api.barrels.gd pnpm --filter @barrelsgd/pwa-printix build
VITE_API_URL=http://localhost:8000
