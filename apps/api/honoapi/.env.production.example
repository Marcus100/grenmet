# ===========================================
# HonoAPI - Production Environment
# ===========================================
# This file is used for production deployments
# ===========================================

# ========= Environment =========
NODE_ENV=production
ENVIRONMENT=production

# ========= Server Configuration =========
PORT=4000
HOST=0.0.0.0
# Fail closed until browser consumers are explicitly configured.
CORS_ORIGINS=

# ========= API Configuration =========
API_PREFIX=/api/v1

# ========= Developer Notes =========
# Production Deployment:
# - Set CORS_ORIGINS to the comma-separated deployed consumer origins
# - Production mode for performance
