# ===========================================
# HonoAPI - Staging Environment
# ===========================================
# This file is used for staging deployments
# ===========================================

# ========= Environment =========
NODE_ENV=production
ENVIRONMENT=staging

# ========= Server Configuration =========
PORT=4000
HOST=0.0.0.0
# Fail closed until browser consumers are explicitly configured.
CORS_ORIGINS=

# ========= API Configuration =========
API_PREFIX=/api/v1

# ========= Developer Notes =========
# Staging Deployment:
# - Set CORS_ORIGINS to the comma-separated deployed consumer origins
# - Production mode for performance
