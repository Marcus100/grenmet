{% extends "base.html.j2" %}
{% block content %}
    <section class="card headline">
      {{ icon(condition_icon, "headline-icon", "sky-ink") }}
      <div>
        <p class="eyebrow sky">{{ period }}</p>
        <p class="summary">{{ summary or "—" }}</p>
      </div>
    </section>

    <div class="row">
      <section class="card conditions">
        <h2 class="eyebrow">Conditions</h2>
        <ul class="tiles">
          {% for tile in tiles %}
          <li>
            {{ icon(tile.icon, "tile-icon") }}
            <div><strong>{{ tile.value }}</strong><span>{{ tile.label }}</span></div>
          </li>
          {% else %}
          <li class="empty">No conditions supplied.</li>
          {% endfor %}
        </ul>
      </section>

      <section class="card ibf">
        <h2 class="eyebrow">Impact-based forecast</h2>
        <div class="matrix-wrap">
          <span class="axis-y">Likelihood</span>
          <div class="matrix">
            {% for row in matrix %}{% for cell in row %}
            <div class="cell risk-{{ cell.colour }}">
              {% for mark in cell.marks %}<span class="mark">{{ mark }}</span>{% endfor %}
            </div>
            {% endfor %}{% endfor %}
          </div>
          <span class="axis-x">Impact</span>
        </div>
        <ol class="caption">
          {% for item in advisories %}
          <li><b>{{ loop.index }}</b> {{ item.title }} ({{ item.product | lower }}): {{ (item.likelihood or "unassessed") | lower }} likelihood, {{ (item.impact or "unassessed") | lower }} impacts</li>
          {% else %}
          <li class="none">No CAP alerts or GMS bulletins were in force at issue.</li>
          {% endfor %}
          {% for item in all_clear %}
          <li class="info">All clear (information): {{ item.title }} bulletin, {{ item.valid }}</li>
          {% endfor %}
          {% if not complete %}<li class="none">Some warning sources were unavailable at issue; check weather.gd.</li>{% endif %}
        </ol>
      </section>
    </div>

    {% include "_advisories.html.j2" %}

    {% if outlook %}
    <section class="outlook">
      <h2 class="eyebrow">Next four days</h2>
      <div class="days">
        {% for day in outlook %}
        <article class="card day-card">
          <h3>{{ day.label }}</h3>
          <p class="day-weather">{{ day.weather }}</p>
          {% if day.tiles %}
          <ul class="tiles compact">
            {% for tile in day.tiles %}
            <li>
              {{ icon(tile.icon, "tile-icon") }}
              <div><strong>{{ tile.value }}</strong><span>{{ tile.label }}</span></div>
            </li>
            {% endfor %}
          </ul>
          {% endif %}
        </article>
        {% endfor %}
      </div>
    </section>
    {% endif %}

    {% if word %}
    <section class="card word">
      <p class="eyebrow">Word of the day · {{ word }}</p>
      <p>{{ definition }}</p>
    </section>
    {% endif %}
{% endblock %}
