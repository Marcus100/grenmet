{% extends "base.html.j2" %}
{% block content %}
    <section class="level-banner risk-{{ level_colour or 'grey' }}">
      {{ icon("triangle-alert", "banner-icon", tone_for(level_colour)) }}
      <div>
        <strong>{{ level_title | upper }}</strong>
        <span>{{ notice or "—" }}</span>
      </div>
      {% if area %}<span class="banner-area">{{ area }}</span>{% endif %}
    </section>

    <section class="card headline">
      {{ icon(hazard_icon, "headline-icon", "sky-ink") }}
      <div>
        <p class="eyebrow sky">Synopsis</p>
        <p class="summary">{{ synopsis or "—" }}</p>
      </div>
    </section>

    <div class="row">
      <section class="card conditions">
        <h2 class="eyebrow">{{ "Conditions" if tiles else "Details" }}</h2>
        {% if tiles %}
        <ul class="tiles">
          {% for tile in tiles %}
          <li>
            {{ icon(tile.icon, "tile-icon") }}
            <div><strong>{{ tile.value }}</strong><span>{{ tile.label }}</span></div>
          </li>
          {% endfor %}
        </ul>
        {% endif %}
        {% if details %}
        <dl class="details{% if tiles %} after-tiles{% endif %}">
          {% for label, value in details %}
          <dt>{{ label }}</dt><dd>{{ value }}</dd>
          {% endfor %}
        </dl>
        {% endif %}
        {% if not tiles and not details %}<p class="muted">No further details supplied.</p>{% endif %}
      </section>

      <section class="card ibf">
        <h2 class="eyebrow">Impact-based assessment</h2>
        <div class="matrix-wrap">
          <span class="axis-y">Likelihood</span>
          <div class="matrix">
            {% for row in matrix %}{% for cell in row %}
            <div class="cell risk-{{ cell.colour }}">
              {% for mark in cell.marks %}<span class="mark">✓</span>{% endfor %}
            </div>
            {% endfor %}{% endfor %}
          </div>
          <span class="axis-x">Impact</span>
        </div>
        <p class="caption">
          {% if likelihood and impact %}{{ likelihood }} likelihood of {{ impact | lower }} impacts.{% else %}Likelihood and impact not assessed.{% endif %}
        </p>
      </section>
    </div>

    <section class="advisories">
      <article class="alert">
        <div class="alert-head risk-{{ level_colour or 'grey' }}">
          {{ icon("triangle-alert", "alert-icon", tone_for(level_colour)) }}
          <div>
            <strong>{{ level_title | upper }}</strong>
            <span>{{ hazard_name }}</span>
          </div>
        </div>
        <div class="alert-body">
          <h3>Expected impacts</h3>
          <p>{{ impacts or "—" }}</p>
          <h3>Recommended response</h3>
          <p>{{ response or "—" }}</p>
        </div>
        <div class="alert-foot"><b>Valid</b> {{ valid }}</div>
      </article>
    </section>
{% endblock %}
