# ===========================================
# FastAPI Backend - Local Development Environment
# ===========================================
# Copy this file to .env.local and update values as needed:
#   cp .env.local.example .env.local
#
# For production, use stronger secrets generated with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# ===========================================

# ========= Environment Selection =========
## One of: local | staging | production
ENVIRONMENT=local

# ========= Project Identity =========
# Human-readable project title
PROJECT_NAME="Barrels Grenada"

# ========= Hosts =========
# Public client origin used in emails and CORS
# Leave empty for backend-only development
FRONTEND_HOST=http://localhost:3000
# Public API origin for links the API puts in emails (optional; falls back to
# http://localhost:8000). Must be a full URL when set.
# API_BASE_URL=http://localhost:8000

# ========= API Configuration =========
# API version prefix (default: /api/v1)
API_V1_STR=/api/v1

# CORS origins accepted by the backend
# Comma-separated list or JSON array format
# Backend-only defaults allow direct API access
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:3002","http://localhost:3003","http://localhost:3004","http://localhost:3005","http://localhost:3006","http://localhost:3009","http://localhost:8000","http://localhost:5173","http://172.22.0.1:3000"]
# ========= Security =========
# Generate a strong secret (REQUIRED for production):
#   openssl rand -base64 32
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# For local dev, "changethis" is acceptable but will show warnings
SECRET_KEY=changethis

# Legacy bearer-token expiration (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Browser-session token and rotating-session lifetime
SESSION_ACCESS_TOKEN_EXPIRE_MINUTES=15
SESSION_EXPIRE_DAYS=30
# GAA Admin's cookie name for the cookie-authenticated routes (ADR-0017).
BROWSER_SESSION_COOKIE_NAME=admin_session
# Single sign-on secrets (32+ characters, a different value per app); set the
# same value in the matching web app. Empty switches single sign-on off for that
# app. The apps' public URLs default to the local ports in docs/ports.md; override
# with GAA_ADMIN_APP_URL, CMS_APP_URL, CAP_APP_URL, BARRELS_ADMIN_APP_URL,
# EVENTS_APP_URL, GMSDASH_APP_URL, BOOKINGS_APP_URL, ACCOUNT_APP_URL,
# MBIA_APP_URL, SIGNAL_APP_URL, DOCS_APP_URL, WEATHER_APP_URL, PRINTIX_APP_URL
# only when an app runs elsewhere.
GAA_ADMIN_SSO_CLIENT_SECRET=
CMS_SSO_CLIENT_SECRET=
EVENTS_SSO_CLIENT_SECRET=
BARRELS_ADMIN_SSO_CLIENT_SECRET=
CAP_SSO_CLIENT_SECRET=
GMSDASH_SSO_CLIENT_SECRET=
BOOKINGS_SSO_CLIENT_SECRET=
ACCOUNT_SSO_CLIENT_SECRET=
MBIA_SSO_CLIENT_SECRET=
SIGNAL_SSO_CLIENT_SECRET=
DOCS_SSO_CLIENT_SECRET=
# Legacy: the weather site no longer signs in, but the API still reads this.
# WEATHER_SSO_CLIENT_SECRET=

# Privileged two-step verification. Unset: disabled when ENVIRONMENT=local,
# enforce elsewhere. Enforce needs AUTH_TOTP_ENCRYPTION_KEYS: a JSON array of
# Fernet keys, current first (python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())").
# AUTH_PRIVILEGED_MFA_MODE=disabled
# AUTH_TOTP_ENCRYPTION_KEYS=

# Optional Google sign-in (all three empty = off).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=
# Phone/WhatsApp codes: disabled (default) or console (local only, logs codes).
# PHONE_OTP_PROVIDER=disabled

# Shared with the web apps that forward the visitor address (bookings, events,
# gms, mbia, auth): 32+ characters, different from SECRET_KEY. Empty: rate limits
# key on the connecting address. VISITOR_IP_PROXY_HOPS is the number of proxies
# in front of the API (1 to 5; default 1).
# TRUSTED_WEB_SECRET=
# VISITOR_IP_PROXY_HOPS=1
# Default per-address request limit (requests a minute; 0 = off) and its mode:
# log (default, only logs), enforce (answers 429) or off.
# DEFAULT_RATE_LIMIT_PER_MINUTE=1000
# DEFAULT_RATE_LIMIT_MODE=log
# Compose network whose direct callers are never rate limited.
# INTERNAL_CALLER_NETWORK=172.31.250.0/24

# HMAC key for hashed suppressed/unsubscribed email addresses. Empty is allowed
# only when ENVIRONMENT=local (a fixed development key is used).
# EMAIL_HASH_PEPPER=

# Redis-backed login lockout policy
LOGIN_MAX_FAILED_ATTEMPTS=10
LOGIN_LOCKOUT_SECONDS=900
LOGIN_FAILURE_WINDOW_SECONDS=900

# Bootstrap superuser for first-time initialization
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis

# ========= Database (PostgreSQL) =========
# In Docker Compose, 'grenmet-postgres' is the container name defined in infra/docker/docker-compose.yml
# Change only if using an external DB host
POSTGRES_SERVER=grenmet-postgres
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=changethis

# Dedicated FastAPI-owned domain databases. The passwords must match the
# matching *_DB_PASSWORD in infra/docker/.env.local. Use grenmet-postgres inside
# Compose, or host.docker.internal from the agent devcontainer. prestart.sh
# migrates each one whose URL is set; weather products and the archive are also
# required by python3 scripts/production/check-local-env.py.
WXWATCH_DATABASE_URL=postgresql://wxwatch:changethis@grenmet-postgres:5432/wxwatch
WXPRODUCTS_DATABASE_URL=postgresql://wxproducts:changethis@grenmet-postgres:5432/wxproducts
EREGISTER_DATABASE_URL=postgresql://eregister:changethis@grenmet-postgres:5432/eregister
JANITORIAL_DATABASE_URL=postgresql://janitorial:changethis@grenmet-postgres:5432/janitorial
TRANSPORT_DATABASE_URL=postgresql://transport:changethis@grenmet-postgres:5432/transport
# Expected database name for the eRegister migration guard and import scripts.
# EREGISTER_DB_NAME=eregister

# Main-database connection pool and migration timeouts (defaults shown).
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT=10
# DB_POOL_RECYCLE=1800
# MIGRATION_LOCK_TIMEOUT=10s
# DB_IDLE_IN_TRANSACTION_TIMEOUT=300

# ========= Email Configuration =========
# Email provider preference: Resend (recommended) or SMTP

# Resend API Key (preferred for staging/production)
# If RESEND_API_KEY is set, backend will use Resend
# If not set, backend falls back to SMTP settings below
RESEND_API_KEY=

# SMTP Configuration (fallback or for local MailCatcher)
# For local dev with MailCatcher, these are overridden in docker-compose.override.yml
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=True
SMTP_SSL=False

# Email sender configuration
EMAILS_FROM_EMAIL=noreply@example.com
EMAILS_FROM_NAME=

# Email reset token expiration (in hours)
# Default: 48 hours
EMAIL_RESET_TOKEN_EXPIRE_HOURS=48

# Test email recipient (for email testing endpoints)
EMAIL_TEST_USER=test@example.com

# Optional React Email renderer hosted by the web-auth app.
# Set both values together when enabling remote template rendering.
EMAIL_RENDER_URL=
EMAIL_RENDER_SECRET=

# Optional Resend webhook signing secret.
RESEND_WEBHOOK_SECRET=

# Notification email: restrict recipient domains (comma-separated; empty = all)
# and set the staff portal address used in notification links.
# NOTIFICATIONS_EMAIL_ALLOWED_DOMAINS=
# NOTIFICATIONS_WEB_BASE_URL=http://localhost:3001
# NOTIFICATIONS_BATCH_SIZE=50
# NOTIFICATIONS_MAX_ATTEMPTS=5

# ========= Public forms and mailing lists =========
# Inboxes that receive website messages. Unset: stored and logged only.
# MBIA_CONTACT_RECIPIENT=
# BARRELS_CONTACT_RECIPIENT=
# GMS_DATA_REQUEST_RECIPIENT=
# Cloudflare Turnstile (secret key; the matching site key goes in the web apps).
# TURNSTILE_ENABLED=false
# TURNSTILE_SECRET_KEY=
# AUTH_TURNSTILE_SECRET_KEY=
# Mailing-list key to site origin (JSON); confirm links redirect only to these.
# SUBSCRIPTIONS_SITE_URLS={"signal":"http://localhost:3004","barrels":"http://localhost:4173","gms-alerts":"http://localhost:3003"}
# SUBSCRIPTIONS_API_BASE_URL=http://localhost:8000
# NEWSLETTER_DIGEST_ENABLED=false
# NEWSLETTER_POSTS_FEED_URL=

# ========= Billing (Stripe) =========
# Use test-mode values for local development. Never commit populated secrets.
BILLING_STRIPE_SECRET_KEY=
BILLING_STRIPE_WEBHOOK_SECRET=
# Recurring Price ID created in Stripe (for example, an XCD monthly test Price).
BILLING_STRIPE_PRICE_ID=
# Stripe replaces the literal placeholder after a successful Checkout.
BILLING_CHECKOUT_SUCCESS_URL="http://localhost:8000/scalar?checkout=success&session_id={CHECKOUT_SESSION_ID}"
BILLING_CHECKOUT_CANCEL_URL="http://localhost:8000/scalar?checkout=cancelled"

# Stripe payments core (ADR-0027). Test mode only: the key must start sk_test_.
# Events and Bookings return addresses come from EVENTS_APP_URL / BOOKINGS_APP_URL.
# PAYMENTS_STRIPE_SECRET_KEY=
# PAYMENTS_STRIPE_WEBHOOK_SECRET=
# PAYMENTS_STRIPE_SUCCESS_URL=
# PAYMENTS_STRIPE_CANCEL_URL=
# Events checkout holds and refund policy.
# EVENTS_ORDER_HOLD_MINUTES=30
# EVENTS_REFUND_CUTOFF_HOURS=48
# Bookings: public app and Babydoll site addresses, deposit hold.
# BOOKINGS_DEPOSIT_HOLD_MINUTES=30
# BOOKINGS_BABYDOLL_SITE_URL=https://babydoll.barrels.gd

# ========= Object Storage (S3-compatible) =========
# Leave credentials empty to keep object storage disabled locally.
STORAGE_ENDPOINT_URL=
STORAGE_REGION=us-east-1
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BASE_URL=
STORAGE_PRESIGN_EXPIRY_SECONDS=3600

# ========= Background Worker =========
# Docker Compose supplies REDIS_URL to the API and worker containers.
REDIS_URL=
CAP_JOB_BATCH_SIZE=20
CAP_JOB_MAX_ATTEMPTS=5
CAP_JOB_POLL_SECONDS=10

# Comma-separated addresses told when a warning delivery job fails every attempt.
# CAP_DELIVERY_FAILURE_RECIPIENTS=
# Worker backlog check thresholds and Sentry Cron check-ins.
# OUTBOX_STALE_MINUTES=30
# OUTBOX_DEAD_WINDOW_HOURS=24
# OUTBOX_ALERT_THRESHOLD=0
# SENTRY_CRONS_ENABLED=false

# ========= CAP XML Signing =========
# Leave certificate and key empty to publish unsigned CAP XML locally.
CAP_SIGNING_CERT=
CAP_SIGNING_KEY=
CAP_SIGNING_KEY_REF=cap-signing-key

# ========= Observability =========
# Sentry DSN for error tracking
# Keep empty if not used; must be either empty or a valid DSN URL
SENTRY_DSN=
# Plain-text logs instead of JSON, and the log level.
# LOG_FORMAT=text
# LOG_LEVEL=INFO
# Operational metrics and the worker heartbeat (off by default).
# TELEMETRY_ENABLED=false
# TELEMETRY_ENVIRONMENT=development
# TELEMETRY_REDIS_URL=redis://localhost:6379/0
# TELEMETRY_WORKER_HEARTBEAT_URL=

# ========= Weather, observations and data feeds (all optional) =========
# eRegister: inboxes for "Email observation", and the wis2box drop target
# (a local directory, or an S3 endpoint with its credentials).
# EREGISTER_OBS_RECIPIENTS=
# EREGISTER_SEND_REQUIRE_ACCEPTED=true
# WIS2BOX_INCOMING_DIR=
# WIS2BOX_S3_ENDPOINT_URL=
# WIS2BOX_S3_BUCKET=wis2box-incoming
# WIS2BOX_S3_ACCESS_KEY_ID=
# WIS2BOX_S3_SECRET_ACCESS_KEY=
# WIS2BOX_TOPIC_HIERARCHY=origin/a/wis2/gd-metservice/data/core/weather/surface-based-observations/synop
# WIS2BOX_WIGOS_ID=0-20000-0-78958
# WIS2BOX_MAX_ATTEMPTS=5
# Station metadata for the CSV: WIS2BOX_STATION_LATITUDE, _LONGITUDE,
# _STATION_HEIGHT_M, _BAROMETER_HEIGHT_M, _THERMOMETER_HEIGHT_M, _ANEMOMETER_HEIGHT_M.
# WxWatch archive: shared ingest token (32+ characters, also set for the
# collector in scripts/scrapy-wxwatch), local image directory, NHC archive root.
# WXWATCH_INGEST_TOKEN=
# WXWATCH_LOCAL_IMAGES_DIR=
# WXWATCH_LOCAL_ASSET_ROOTS={}
# WXWATCH_NHC_ROOT=
# WXWATCH_ALERT_ORGANISATION_ID=gaa
# WXWATCH_FEED_STALE_MINUTES=180
# WXWATCH_FEED_IGNORED_SOURCES=
# OpenSky flights board (research use) and Copernicus feeds. Free accounts.
# FLIGHTS_OPENSKY_ENABLED=false
# OPENSKY_CLIENT_ID=
# OPENSKY_CLIENT_SECRET=
# COPERNICUSMARINE_SERVICE_USERNAME=
# COPERNICUSMARINE_SERVICE_PASSWORD=
# CDSAPI_URL=https://ads.atmosphere.copernicus.eu/api
# CDSAPI_KEY=
# Model guidance downloads hundreds of MB a run: enable deliberately.
# MODELS_GUIDANCE_ENABLED=false
# MODELS_GUIDANCE_MODELS=ifs,aifs,gfs
# MODELS_GUIDANCE_CACHE_DIR=
# Browser push for CAP alerts. Generate: python -m src.push.cli generate-vapid
# WEBPUSH_VAPID_PUBLIC_KEY=
# WEBPUSH_VAPID_PRIVATE_KEY=
# WEBPUSH_CONTACT=mailto:alerts@example.com

# ========= Social posting, organisations, payroll (all optional) =========
# Social posts stay dry runs until the Meta settings and the social-live-posting
# feature flag are set. CMS_DISTRIBUTION_SECRET matches apps/web/cms.
# CMS_DISTRIBUTION_SECRET=
# META_PAGE_ID=
# META_INSTAGRAM_ACCOUNT_ID=
# META_PAGE_ACCESS_TOKEN=
# SOCIAL_LINK_HOSTS=
# SOCIAL_IMAGE_HOSTS=
# SOCIAL_TOKEN_ENCRYPTION_KEYS=
# JSON array of Fernet keys (current first) for organisation-stored secrets.
# ORG_SECRET_ENCRYPTION_KEYS=
# Payslip signing: comma-separated keyid:secret pairs, secrets of 32+ characters.
# PAYSLIP_HMAC_KEYS=
# Rewards: gifting switch and limits (defaults in src/rewards/config.py).
# REWARDS_GIFTING_ENABLED=false

# ========= Tuning (defaults shown; uncomment only to change) =========
# Single-line comments below name every remaining FastAPI setting; the defaults live in
# the matching src/<domain>/config.py and are explained in docs/env.md.
# AUTH_FRONTEND_URL=http://localhost:3000
# ALLOW_PUBLIC_SIGNUP=true
# EVENTS_APP_URL=http://localhost:3009
# EVENTS_GOOGLE_REDIRECT_URI=
# GAA_ADMIN_APP_URL=http://localhost:3001
# BARRELS_ADMIN_APP_URL=http://localhost:3012
# CAP_APP_URL=http://localhost:3010
# CMS_APP_URL=http://localhost:3006
# WEATHER_APP_URL=http://localhost:3003
# MBIA_APP_URL=http://localhost:3005
# SIGNAL_APP_URL=http://localhost:3004
# DOCS_APP_URL=http://localhost:3002
# GMSDASH_APP_URL=http://localhost:3013
# BOOKINGS_APP_URL=http://localhost:3015
# ACCOUNT_APP_URL=http://localhost:3018
# PRINTIX_APP_URL=https://scan.barrels.gd
# BCRYPT_ROUNDS=12
# BILLING_INVOICE_CURRENCY=XCD
# BILLING_INVOICE_PAYMENT_TERMS_DAYS=30
# BILLING_INVOICE_LEGAL_ENTITY_NAME=Barrels Grenada
# BILLING_INVOICE_DEFAULT_TAX_RATE=15
# BILLING_INVOICE_NUMBER_PREFIX=BG
# BILLING_INVOICE_NUMBER_PADDING=4
# BILLING_INVOICE_REMINDER_GRACE_DAYS=2
# META_GRAPH_API_VERSION=v24.0
# COPERNICUS_WAVE_DATASET_ID=cmems_mod_glo_wav_anfc_0.083deg_PT3H-i
# COPERNICUS_SST_DATASET_ID=cmems_mod_glo_phy_anfc_0.083deg_PT1H-m
# CAMS_DATASET_ID=cams-global-atmospheric-composition-forecasts
# ENVIRONMENT_FORECAST_HOURS=120
# ENVIRONMENT_STALE_AFTER_HOURS=12
# ENVIRONMENT_REQUEST_TIMEOUT_SECONDS=600
# WIS2BOX_STATION_LATITUDE=12.0042
# WIS2BOX_STATION_LONGITUDE=-61.7862
# WIS2BOX_STATION_HEIGHT_M=12.0
# WIS2BOX_BAROMETER_HEIGHT_M=13.7
# WIS2BOX_THERMOMETER_HEIGHT_M=1.7
# WIS2BOX_ANEMOMETER_HEIGHT_M=10.0
# OPENSKY_API_URL=https://opensky-network.org/api
# OPENSKY_TOKEN_URL=https://auth.opensky-network.org/auth/realms/opensky-network/protocol/openid-connect/token
# OPENSKY_TIMEOUT_SECONDS=20.0
# FLIGHTS_WINDOW_HOURS=48
# FLIGHTS_CACHE_TTL_SECONDS=21600
# MODELS_GUIDANCE_POINTS=[]  # JSON list of points; default MBIA, Lauriston, Petite Martinique
# MODELS_GUIDANCE_POLL_MINUTE=20
# MODELS_GUIDANCE_HORIZON_HOURS=240
# MODELS_GUIDANCE_RETENTION_DAYS=7
# MODELS_GUIDANCE_TIMEOUT_SECONDS=60.0
# MODELS_GUIDANCE_GFS_FILTER_URL=https://nomads.ncep.noaa.gov/cgi-bin/filter_gfs_0p25.pl
# MODELS_GUIDANCE_GFS_DATA_URL=https://nomads.ncep.noaa.gov/pub/data/nccf/com/gfs/prod
# MODELS_GUIDANCE_GFS_REQUEST_PAUSE_SECONDS=0.5
# PAYMENTS_STRIPE_API_BASE=https://api.stripe.com
# PAYMENTS_WEBHOOK_TOLERANCE_SECONDS=300
# PAYMENTS_REQUEST_TIMEOUT_SECONDS=10.0
# PAYMENTS_REFUND_RECONCILE_WINDOW_DAYS=180
# PAYMENTS_REFUND_RECONCILE_BATCH=200
# PAYMENTS_REFUND_RECONCILE_BUDGET_SECONDS=240.0
# PAYMENTS_REFUND_RECONCILE_PAGE_MARGIN_SECONDS=20.0
# WEBPUSH_MAX_FAILURES=10
# REWARDS_VELOCITY_MAX_EARNS=10
# REWARDS_VELOCITY_WINDOW_MINUTES=60
# REWARDS_GIFT_DAILY_CAP_PER_SENDER=3
# REWARDS_GIFT_LIFETIME_CAP_PER_RECIPIENT=10
# REWARDS_GIFT_REVERSAL_HOURS=24
# REWARDS_LEADERBOARD_MIN_COHORT=10
# REWARDS_LEADERBOARD_MAX_ROWS=50
# SUBSCRIPTIONS_CONFIRM_TTL_DAYS=7
# SUBSCRIPTIONS_RESEND_MINUTES=10
# NEWSLETTER_BATCH_SIZE=50
# NEWSLETTER_BATCH_INTERVAL_SECONDS=60

# ========= Developer Notes =========
# Local Development Setup:
# 1. Copy this file: cp .env.local.example .env.local
# 2. Update SECRET_KEY, POSTGRES_PASSWORD, FIRST_SUPERUSER_PASSWORD
# 3. Start services (host only): pnpm start
#
# Access Services:
# - API Docs: http://localhost:8000/docs
# - Health Check: http://localhost:8000/api/v1/utils/health-check/
# - Database UI (Adminer): http://localhost:8080
# - Email Testing (MailCatcher): http://localhost:1080
#
# MailCatcher Configuration:
# For local development, apps/api/fastapi/docker-compose.yml overrides the SMTP
# settings to use MailCatcher (SMTP_HOST=grenmet-mailcatcher, SMTP_PORT=1025,
# SMTP_TLS=false), whatever the values above say.
