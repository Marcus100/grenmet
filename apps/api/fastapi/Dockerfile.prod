# syntax=docker/dockerfile:1.7
# Multi-stage production Dockerfile following best practices
# Based on: https://github.com/fastapi/full-stack-fastapi-template

# Stage 1: Builder - Install dependencies
FROM python:3.13-slim-bookworm@sha256:ed86c82274b3c69b52fb5820f358f0bd7df0b603332063cb5c6e32bd220c3e6e AS builder

# Install uv for fast dependency management
COPY --from=ghcr.io/astral-sh/uv:0.11.26@sha256:3d868e555f8f1dbc324afa005066cd11e1053fc4743b9808ca8025283e65efa5 /uv /bin/uv

# Set environment variables for Python
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_SYSTEM_PYTHON=1 \
    UV_LINK_MODE=copy

# Set working directory
WORKDIR /app

# Copy workspace metadata first for better layer caching
COPY pyproject.toml uv.lock ./
COPY apps/api/fastapi/pyproject.toml apps/api/fastapi/pyproject.toml
COPY scripts/scrapy-wxwatch/pyproject.toml scripts/scrapy-wxwatch/pyproject.toml
COPY scripts/sutron-collector/pyproject.toml scripts/sutron-collector/pyproject.toml
COPY scripts/gms-ingest/pyproject.toml scripts/gms-ingest/pyproject.toml
COPY notebooks/pyproject.toml notebooks/pyproject.toml
COPY geonetcast/pyproject.toml geonetcast/pyproject.toml

# Install only FastAPI's production dependencies in the shared workspace venv.
# The cache mount is only useful without --no-cache, which would otherwise make
# uv re-download every wheel on each cache-cold build.
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --package fast-back --no-dev --no-install-workspace

# Install the FastAPI member after its source is available.
COPY apps/api/fastapi/src apps/api/fastapi/src
COPY apps/api/fastapi/alembic apps/api/fastapi/alembic
COPY apps/api/fastapi/alembic.ini apps/api/fastapi/alembic.ini
COPY apps/api/fastapi/email-templates apps/api/fastapi/email-templates
COPY apps/api/fastapi/scripts apps/api/fastapi/scripts
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --package fast-back --no-dev

# Stage 2: Runtime - Minimal production image
FROM python:3.13-slim-bookworm@sha256:ed86c82274b3c69b52fb5820f358f0bd7df0b603332063cb5c6e32bd220c3e6e

# uv is no longer on any startup path — prestart and the worker run straight off
# the venv on PATH. Kept only as an escape hatch for ad-hoc `docker exec` ops.
COPY --from=builder /bin/uv /bin/uv

# Refresh the runtime trust store and PCRE2 as well as curl. Installing curl
# alone does not update unrelated packages inherited from the pinned base.
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates libpcre2-8-0 \
    && dpkg --compare-versions "$(dpkg-query -W -f='${Version}' ca-certificates)" ge '20250419~deb12u1' \
    && dpkg --compare-versions "$(dpkg-query -W -f='${Version}' libpcre2-8-0)" ge '10.42-1+deb12u1' \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Create the non-root user before any application content is copied. Every COPY
# below then lands already owned by appuser, so no recursive chown is needed.
# A `chown -R /app` after the fact rewrites the entire venv into a second layer,
# roughly doubling image size and adding minutes to the build.
# HOME/UV_CACHE_DIR support explicit operational commands; production startup
# uses the installed virtual environment without resolving dependencies.
RUN groupadd -r appuser \
    && useradd -r -g appuser -u 1000 -m appuser \
    && mkdir -p /app /home/appuser/.cache/uv \
    && chown appuser:appuser /app \
    && chown -R appuser:appuser /home/appuser

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/app/.venv/bin:$PATH" \
    HOME=/home/appuser \
    UV_CACHE_DIR=/home/appuser/.cache/uv \
    UV_LINK_MODE=copy

# Keep the workspace root stable across builder and runtime stages.
WORKDIR /app

# Copy virtual environment from builder. Ownership is applied as the layer is
# written, avoiding an extra recursive ownership layer.
COPY --from=builder --chown=appuser:appuser /app/.venv /app/.venv

# Copy workspace metadata used by uv-powered operational commands
COPY --chown=appuser:appuser pyproject.toml uv.lock ./
COPY --chown=appuser:appuser apps/api/fastapi/pyproject.toml apps/api/fastapi/pyproject.toml
COPY --chown=appuser:appuser scripts/scrapy-wxwatch/pyproject.toml scripts/scrapy-wxwatch/pyproject.toml
COPY --chown=appuser:appuser scripts/sutron-collector/pyproject.toml scripts/sutron-collector/pyproject.toml
COPY --chown=appuser:appuser notebooks/pyproject.toml notebooks/pyproject.toml
COPY --chown=appuser:appuser geonetcast/pyproject.toml geonetcast/pyproject.toml

# Copy application code
COPY --chown=appuser:appuser apps/api/fastapi/src apps/api/fastapi/src
COPY --chown=appuser:appuser apps/api/fastapi/alembic apps/api/fastapi/alembic
COPY --chown=appuser:appuser apps/api/fastapi/alembic.ini apps/api/fastapi/alembic.ini
COPY --chown=appuser:appuser apps/api/fastapi/email-templates apps/api/fastapi/email-templates
COPY --chown=appuser:appuser apps/api/fastapi/scripts apps/api/fastapi/scripts

# Switch to non-root user
USER appuser

# Run application and operational commands from the FastAPI member.
WORKDIR /app/apps/api/fastapi

# Expose port (8000 is standard for FastAPI)
EXPOSE 8000

# Health check - improved for production
HEALTHCHECK --interval=30s --timeout=15s --start-period=60s --retries=5 \
    CMD curl --fail --silent --show-error --retry 3 --retry-delay 5 http://localhost:8000/api/v1/utils/health-check/ || exit 1

# An agent is not provisioned by this image. Keep all agent exports opt-in;
# enable them only with a reachable DD_TRACE_AGENT_URL and environment tags.
ENV DD_TRACE_ENABLED=false
ENV DD_INSTRUMENTATION_TELEMETRY_ENABLED=false
ENV DD_REMOTE_CONFIGURATION_ENABLED=false
CMD ["ddtrace-run", "uvicorn", "src.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips", "*"]
