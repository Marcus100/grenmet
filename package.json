{
  "name": "barrelsgd-monorepo",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24",
    "pnpm": ">=12.3.4"
  },
  "scripts": {
    "build": "turbo run build",
    "clean": "git clean -xdf node_modules",
    "dev": "turbo run dev --parallel",
    "start": "docker compose -p grenmet --env-file infra/docker/.env.local -f infra/docker/docker-compose.yml --profile tools up -d && docker compose -p grenmet-api --env-file apps/api/fastapi/.env.local -f apps/api/fastapi/docker-compose.yml up --build",
    "stop": "docker compose -p grenmet-api --env-file apps/api/fastapi/.env.local -f apps/api/fastapi/docker-compose.yml down --remove-orphans && docker compose -p grenmet --env-file infra/docker/.env.local -f infra/docker/docker-compose.yml --profile tools down --remove-orphans",
    "reset": "docker compose -p grenmet --env-file infra/docker/.env.local -f infra/docker/docker-compose.yml --profile tools down -v && docker compose -p grenmet --env-file infra/docker/.env.local -f infra/docker/docker-compose.yml up postgres -d",
    "logs": "docker compose -p grenmet-api --env-file apps/api/fastapi/.env.local -f apps/api/fastapi/docker-compose.yml logs -f",
    "logs:infra": "docker compose -p grenmet --env-file infra/docker/.env.local -f infra/docker/docker-compose.yml --profile tools logs -f",
    "status": "docker compose -p grenmet --env-file infra/docker/.env.local -f infra/docker/docker-compose.yml --profile tools ps && docker compose -p grenmet-api --env-file apps/api/fastapi/.env.local -f apps/api/fastapi/docker-compose.yml ps",
    "dev:web": "turbo run dev --filter=@barrelsgd/web-*",
    "dev:web:admin": "turbo run dev --filter=@barrelsgd/web-admin",
    "dev:web:cap": "turbo run dev --filter=@barrelsgd/web-cap",
    "dev:web:gmsdash": "turbo run dev --filter=@barrelsgd/web-gmsdash",
    "dev:web:gaa-admin": "turbo run dev --filter=@barrelsgd/web-gaa-admin",
    "dev:web:docs": "turbo run dev --filter=@barrelsgd/web-docs",
    "dev:web:auth": "turbo run dev --filter=@barrelsgd/web-auth",
    "dev:web:gms": "turbo run dev --filter=@barrelsgd/web-gms",
    "dev:web:signal": "turbo run dev --filter=@barrelsgd/web-signal",
    "dev:web:mbia": "turbo run dev --filter=@barrelsgd/web-mbia",
    "dev:web:events": "turbo run dev --filter=@barrelsgd/web-events",
    "dev:web:elections": "turbo run dev --filter=@barrelsgd/web-elections",
    "dev:web:babydoll": "turbo run dev --filter=@barrelsgd/web-babydoll",
    "dev:web:bookings": "turbo run dev --filter=@barrelsgd/web-bookings",
    "design-system:sync": "node scripts/design-system/design-system-sync.mjs --write",
    "design-system:check": "node scripts/design-system/design-system-sync.mjs --check",
    "design-system:contrast": "node scripts/design-system/design-system-contrast.mjs",
    "design-system:audit": "node scripts/design-system/design-system-audit.mjs",
    "design-system:audit:full": "node scripts/design-system/design-system-audit.mjs --all",
    "docs:check-portfolio": "node scripts/docs/check-portfolio-coverage.mjs",
    "docs:check-links": "node scripts/docs/check-links.mjs",
    "docs:check-style": "node scripts/docs/check-markdown.mjs",
    "guardrails": "node scripts/guardrails/check-blast-radius.mjs",
    "guardrails:tier": "node scripts/guardrails/risk-tier.mjs --base origin/dev",
    "guardrails:staged": "node scripts/guardrails/check-blast-radius.mjs --staged",
    "guardrails:boundaries": "node scripts/guardrails/check-boundaries.mjs",
    "guardrails:private": "node scripts/guardrails/check-private-content.mjs --staged",
    "guardrails:rulesets": "node scripts/guardrails/github-rulesets.mjs --check",
    "test:guardrails": "node --test scripts/guardrails/*.test.mjs scripts/agents/*.test.mjs",
    "session-log:archive": "node scripts/agents/archive-session-log.mjs",
    "agents:report": "node scripts/agents/run-report.mjs",
    "agents:sessions": "node scripts/agents/sessions.mjs",
    "agents:flow": "node scripts/agents/flow.mjs",
    "agents:score": "node scripts/agents/score-sessions.mjs",
    "agents:improve": "node scripts/agents/improve.mjs",
    "agents:routing": "node scripts/agents/routing.mjs",
    "agents:skill-evals": "node scripts/agents/skill-evals.mjs",
    "agents:sweep": "node scripts/agents/claim-issue.mjs sweep",
    "agents:handoff": "node scripts/agents/review-handoff.mjs",
    "coverage:check": "node scripts/guardrails/check-coverage.mjs",
    "e2e": "node scripts/verification/e2e-if-up.mjs",
    "ui:screenshots": "node scripts/agents/ui-screenshots.mjs",
    "test:docs": "node --test scripts/docs/*.test.mjs",
    "prepare": "husky",
    "lint": "turbo run lint",
    "check": "turbo run check",
    "check:fix": "turbo run check:fix",
    "check:ci": "turbo run check:ci",
    "type-check": "turbo run type-check",
    "test": "turbo run test --concurrency=2",
    "validate": "turbo run type-check lint test",
    "fix": "ultracite fix",
    "fix:changed": "node scripts/guardrails/fix-changed.mjs",
    "generate:api-client": "turbo run generate --filter=@barrelsgd/api-client",
    "knip": "PAYLOAD_SECRET=knip-placeholder-secret-0123456789 DATABASE_URL=postgres://knip@localhost/knip knip --dependencies --no-exit-code",
    "knip:unused": "PAYLOAD_SECRET=knip-placeholder-secret-0123456789 DATABASE_URL=postgres://knip@localhost/knip knip --files --no-exit-code",
    "check:drift": "node scripts/api/check-api-drift.mjs",
    "check:api-breaking": "node scripts/api/check-api-breaking.mjs --base origin/dev",
    "dev:web:cms": "turbo run dev --filter=@barrelsgd/web-cms",
    "cms:setup-db": "docker exec -i grenmet-postgres bash < infra/postgres/init-cms.sh",
    "storage:init": "bash scripts/production/init-local.sh",
    "test:delivery": "node --test scripts/ci/*.test.mjs scripts/production/*.test.mjs apps/web/gaa-admin/scripts/*.test.mjs apps/web/cms/scripts/adopt.test.mjs",
    "verify:quick": "pnpm check && pnpm type-check && pnpm test",
    "verify:changed": "node scripts/verification/changed.mjs",
    "verify:backend": "node scripts/verification/run.mjs backend",
    "verify:collectors": "bash scripts/verification/collectors.sh",
    "verify:storage": "node scripts/verification/run.mjs storage",
    "verify:release": "node scripts/verification/run.mjs release",
    "integrations:readiness": "node scripts/integrations/readiness.mjs",
    "test:verification": "node --test scripts/verification/*.test.mjs scripts/integrations/*.test.mjs scripts/perf/*.test.mjs && uv run --isolated --frozen --package fast-back python -m unittest tests.test_database_target"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "husky": "catalog:",
    "knip": "catalog:",
    "lint-staged": "catalog:",
    "turbo": "catalog:",
    "ultracite": "catalog:"
  }
}
