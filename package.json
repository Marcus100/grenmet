{
  "name": "barrelsgd-monorepo",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "turbo run build",
    "clean": "git clean -xdf node_modules",
    "dev": "turbo run dev --parallel",
    "start": "docker compose -p grenmet --env-file infra/docker/.env.local -f infra/docker/docker-compose.yml --profile tools up -d && docker compose -p grenmet-api --env-file apps/api/fastapi/.env.local -f apps/api/fastapi/docker-compose.yml up --build",
    "stop": "docker compose -p grenmet-api --env-file apps/api/fastapi/.env.local -f apps/api/fastapi/docker-compose.yml down --remove-orphans && docker compose -p grenmet --env-file infra/docker/.env.local -f infra/docker/docker-compose.yml --profile tools down --remove-orphans",
    "reset": "docker compose -p grenmet --env-file infra/docker/.env.local -f infra/docker/docker-compose.yml --profile tools down -v && docker compose -p grenmet --env-file infra/docker/.env.local -f infra/docker/docker-compose.yml up postgres -d",
    "status": "docker compose -p grenmet --env-file infra/docker/.env.local -f infra/docker/docker-compose.yml --profile tools ps && docker compose -p grenmet-api --env-file apps/api/fastapi/.env.local -f apps/api/fastapi/docker-compose.yml ps",
    "dev:web": "turbo run dev --filter=@barrelsgd/web-*",
    "dev:web:admin": "turbo run dev --filter=@barrelsgd/web-admin",
    "dev:web:hurricane": "turbo run dev --filter=@barrelsgd/web-hurricaneplan",
    "dev:web:auth": "turbo run dev --filter=@barrelsgd/web-auth",
    "dev:web:spicewx": "turbo run dev --filter=@barrelsgd/web-spicewx",
    "dev:web:signal": "turbo run dev --filter=@barrelsgd/web-signal",
    "dev:web:mbia": "turbo run dev --filter=@barrelsgd/web-mbia",
    "dev:honoapi": "turbo run dev --filter=@barrelsgd/api-hono",
    "design-system:sync": "node scripts/design-system/design-system-sync.mjs --write",
    "design-system:check": "node scripts/design-system/design-system-sync.mjs --check",
    "design-system:contrast": "node scripts/design-system/design-system-contrast.mjs",
    "design-system:audit": "node scripts/design-system/design-system-audit.mjs",
    "design-system:audit:full": "node scripts/design-system/design-system-audit.mjs --all",
    "docs:check-links": "node scripts/docs/check-links.mjs",
    "guardrails": "node scripts/guardrails/check-blast-radius.mjs",
    "guardrails:staged": "node scripts/guardrails/check-blast-radius.mjs --staged",
    "test:guardrails": "node --test scripts/guardrails/*.test.mjs",
    "test:docs": "node --test scripts/docs/*.test.mjs",
    "prepare": "husky",
    "lint": "turbo run lint",
    "check": "turbo run check",
    "check:fix": "turbo run check:fix",
    "check:ci": "turbo run check:ci",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "validate": "turbo run type-check lint test",
    "fix": "ultracite fix",
    "generate:api-client": "turbo run generate --filter=@barrelsgd/api-client",
    "check:drift": "node scripts/api/check-api-drift.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "turbo": "^2.9.14",
    "ultracite": "^7.6.0"
  },
  "pnpm": {
    "allowedDeprecatedVersions": {
      "@esbuild-kit/core-utils": "3.3.2",
      "@esbuild-kit/esm-loader": "2.6.5"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "@react-jvectormap/core>react": "^19",
        "@react-jvectormap/core>react-dom": "^19",
        "@react-jvectormap/world>react": "^19",
        "@react-jvectormap/world>react-dom": "^19",
        "@tanstack/zod-form-adapter>zod": "^4",
        "@kubb/react-fabric": "0.13.1"
      }
    },
    "onlyBuiltDependencies": [
      "@sentry/cli",
      "esbuild",
      "msw"
    ]
  }
}
