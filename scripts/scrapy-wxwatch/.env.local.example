# WxWatch collector (Scrapy). Copy this file: cp .env.local.example .env.local
# The collector holds no database credentials: it posts to the FastAPI archive
# endpoint, and only FastAPI uses WXWATCH_DATABASE_URL.

# Archive endpoint base (default http://127.0.0.1:8000/api/v1/wxwatch). Use HTTPS
# for anything but localhost.
WXWATCH_API_URL=http://127.0.0.1:8000/api/v1/wxwatch
# Shared secret of at least 32 characters; must equal FastAPI's WXWATCH_INGEST_TOKEN.
# Generate: openssl rand -hex 32
WXWATCH_INGEST_TOKEN=

# Image storage. Default: local directory data/images (override with IMAGES_STORE).
# IMAGES_STORE=
# Object storage: set all four together to store images in an S3-compatible bucket.
# STORAGE_ENDPOINT_URL=
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_REGION=us-east-1
# STORAGE_PREFIX=wxwatch
# STORAGE_OBJECT_ACL=private
