<?xml version="1.0" ?>
<!-- Trimmed from the published NHC Graphical Tropical Weather Outlook map file
     (xgtwo/gtwo_atl.kmz, Tue Oct 13 05:20 2026 layout); polygons shortened and a
     second, area-only disturbance added. -->
<kml xmlns="http://earth.google.com/kml/2.1">
    <Document>
        <name>Graphical Tropical Weather Outlook - North Atlantic basin - Tue Oct 13 05:20:00 2026</name>
        <Style id="1">
            <LineStyle><color>9900e6ff</color><width>2</width></LineStyle>
            <PolyStyle><color>9900ffff</color></PolyStyle>
        </Style>
        <Style id="2">
            <LineStyle><color>990092e6</color><width>2</width></LineStyle>
            <PolyStyle><color>990092ff</color></PolyStyle>
        </Style>
        <Style id="lowx">
            <IconStyle><scale>3.0</scale><Icon><href>xl54.png</href></Icon></IconStyle>
        </Style>
        <Placemark>
            <styleUrl>#1</styleUrl>
            <Polygon>
                <outerBoundaryIs>
                    <LinearRing>
                        <coordinates>-32.65,20.79,0 -30.35,18.81,0 -31.97,17.33,0 -34.12,19.10,0 -32.65,20.79,0 </coordinates>
                    </LinearRing>
                </outerBoundaryIs>
            </Polygon>
            <ExtendedData>
                <Data name="Disturbance"><value>1</value></Data>
                <Data name="2day_percentage"><value>10%</value></Data>
                <Data name="2day_category"><value>Low</value></Data>
                <Data name="7day_percentage"><value>10%</value></Data>
                <Data name="7day_category"><value>Low</value></Data>
                <Data name="Discussion">
                    <value>1. Eastern Tropical Atlantic: An elongated area of low pressure located several hundred miles west  of the Cabo Verde Islands is producing a large area of disorganized  showers and thunderstorms well to the east of its center.
 Formation chance through 48 hours...low...10 percent.
 Formation chance through 7 days...low...10 percent. </value>
                </Data>
            </ExtendedData>
        </Placemark>
