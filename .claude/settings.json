{
  "permissions": {
    "allow": [
      "WebFetch(domain:github.com)",
      "WebFetch(domain:next-forge.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "Bash(pnpm dlx:*)",
      "Bash(pnpm fix:*)",
      "Bash(pnpm check:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm type-check:*)",
      "Bash(pnpm install:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm biome:*)",
      "Bash(pnpm turbo:*)",
      "Bash(turbo run:*)",
      "Bash(gh pr *)",
      "Bash(gh run *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/refactoring-ui-check.mjs\""
          }
        ]
      }
    ]
  }
}
