{
  "name": "@barrelsgd/api-client",
  "version": "0.1.0",
  "description": "TypeScript client generated from FastAPI OpenAPI schema",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "kubb generate && biome check --write ./src/gen",
    "generate:watch": "kubb generate --watch",
    "generate:debug": "kubb generate --debug",
    "build": "tsc",
    "type-check": "tsc --project tsconfig.check.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "typescript": "^5.0.0 || ^6.0.0 || ^7.0.0"
  },
  "devDependencies": {
    "@barrelsgd/tsconfig": "workspace:*",
    "@kubb/adapter-oas": "^5.3.11",
    "@kubb/parser-ts": "^5.3.11",
    "@kubb/plugin-fetch": "^5.4.1",
    "@kubb/plugin-react-query": "^5.1.2",
    "@kubb/plugin-ts": "^5.0.2",
    "@kubb/plugin-zod": "^5.1.6",
    "@tanstack/react-query": "catalog:",
    "@types/node": "catalog:",
    "kubb": "^5.3.11",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "private": true,
  "dependencies": {
    "zod": "catalog:"
  }
}
