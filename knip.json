{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/**/*.mjs",
        ".claude/hooks/*.mjs",
        ".devcontainer/*.mjs",
        "apps/web/barrels/*.mjs"
      ]
    },
    "apps/web/*": {
      "entry": [
        "{src/,}env.ts",
        "content-collections.ts",
        "scripts/**/*.{mjs,ts}"
      ]
    },
    "apps/web/docs": {
      "entry": [
        "{src/,}env.ts",
        "content-collections.ts",
        "scripts/**/*.{mjs,ts}",
        "src/content/**/*.mdx"
      ]
    },
    "packages/*": {
      "entry": ["keys.ts", "kubb.config.ts"]
    }
  },
  "ignore": ["packages/api-client/src/gen/**", "surface/**"]
}
